# MDA Journal repository ignore rules
#
# Tracked: project.md, public_html/, the www symlink, .github/, .gitignore.
# Everything listed below lives in the home directory but is tooling,
# private data, or generated output that does not belong in Git.

# Local tooling, shell state, caches and credentials
/.agents/
/.bash_aliases
/.bash_history
/.bash_logout
/.bashrc
/.cache/
/.codex/
/.config/
/.gemini/
/.gitconfig
/.lesshst
/.local/
/.npm/
/.profile
/.ssh/
/.sudo_as_admin_successful
/.viminfo

# Binaries and downloaded tools
/bin/

# Design references, research material and working assets (large, not deployed)
/resources/

# OJS private upload directory (outside the web root)
/files/

# Database dumps and archives kept outside the web root
/backups/
/*.sql
/*.sql.gz
/*.tar.gz
/*.zip

# Local OJS configuration and secrets
/public_html/config.inc.php
/public_html/config.inc.php.*
/public_html/.env
/public_html/.env.*
!/public_html/.env.example

# Runtime cache, generated files and logs
/public_html/cache/**
/public_html/scheduledTaskLogs/**
/public_html/usageStats/**
/public_html/error_log
/public_html/error_log.*
*.log

# User-uploaded public files (keep the protective placeholder)
/public_html/public/**
!/public_html/public/index.html

# Frontend dependencies and test/build output
/public_html/node_modules/
/public_html/coverage/
/public_html/build/
/public_html/dist/
/public_html/cypress/screenshots/
/public_html/cypress/videos/
/public_html/cypress/downloads/

# Temporary and backup files
*.bak
*.tmp
*.temp
*.swp
*.swo
*~

# Editor and operating-system metadata
/.idea/
/.vscode/
.DS_Store
Thumbs.db
